{
  "manifest_version": 3,
  "name": "Tabdar",
  "version": "1.0.0",
  "description": "Manage and organize your browser tabs.",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_title": "Tabdar",
    "default_popup": "index.html",
    "options_page": "dashboard.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}